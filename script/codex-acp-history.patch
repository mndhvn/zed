+describe("Zed fork compatibility", () => {
+    function setupHistory() {
+        const fixture = createCodexMockTestFixture();
+        const client = fixture.getCodexAcpClient();
+        const appServer = fixture.getCodexAppServerClient();
+        vi.spyOn(client, "listSkills").mockResolvedValue({data: []});
+        vi.spyOn(appServer, "threadRead").mockResolvedValue({thread: {
+            id: "source-id",
+            turns: [
+                {id: "first-turn", items: [{type: "userMessage", clientId: "first-message"}]},
+                {id: "second-turn", items: [{type: "userMessage", clientId: "second-message"}]},
+            ],
+        }} as Awaited<ReturnType<typeof appServer.threadRead>>);
+        const fork = vi.spyOn(appServer, "threadFork").mockResolvedValue({
+            thread: {id: "fork-id"},
+        } as Awaited<ReturnType<typeof appServer.threadFork>>);
+        const start = vi.spyOn(appServer, "threadStart").mockResolvedValue({
+            thread: {id: "new-id"},
+        } as Awaited<ReturnType<typeof appServer.threadStart>>);
+        return {fixture, client, fork, start};
+    }
+
+    it("excludes the edited message and later history from the fork", async () => {
+        const {client, fork, start} = setupHistory();
+        const sessionId = await client.forkSessionBeforeClientMessage(
+            "source-id", "second-message", "/workspace", [], [], "openai",
+        );
+        expect(sessionId).toBe("fork-id");
+        expect(fork).toHaveBeenCalledWith(expect.objectContaining({
+            threadId: "source-id", lastTurnId: "first-turn", cwd: "/workspace",
+        }));
+        expect(start).not.toHaveBeenCalled();
+    });
+
+    it("starts an empty history when editing the first message", async () => {
+        const {client, fork, start} = setupHistory();
+        expect(await client.forkSessionBeforeClientMessage(
+            "source-id", "first-message", "/workspace", [], [], "openai",
+        )).toBe("new-id");
+        expect(start).toHaveBeenCalledWith(expect.objectContaining({cwd: "/workspace"}));
+        expect(fork).not.toHaveBeenCalled();
+    });
+
+    it("rejects an unknown message without creating a session", async () => {
+        const {client, fork, start} = setupHistory();
+        await expect(client.forkSessionBeforeClientMessage(
+            "source-id", "missing-message", "/workspace", [], [], "openai",
+        )).rejects.toThrow("No Codex turn found");
+        expect(fork).not.toHaveBeenCalled();
+        expect(start).not.toHaveBeenCalled();
+    });
+
+    it("preserves the full source history through Zed's existing fork command", async () => {
+        const {fixture, fork} = setupHistory();
+        const agent = fixture.getCodexAcpAgent();
+        const source = createTestSessionState({sessionId: "source-id", cwd: "/workspace"});
+        vi.spyOn(agent, "getSessionState").mockReturnValue(source);
+        expect(await agent.extMethod("_session/fork", {sessionId: "source-id"}))
+            .toEqual({sessionId: "fork-id"});
+        expect(fork).toHaveBeenCalledWith(expect.objectContaining({
+            threadId: "source-id", lastTurnId: "second-turn",
+        }));
+        expect(source.sessionId).toBe("source-id");
+    });
+
+    it("rejects history edits and forks while a turn is active", async () => {
+        const {fixture, fork, start} = setupHistory();
+        const agent = fixture.getCodexAcpAgent();
+        vi.spyOn(agent, "getSessionState").mockReturnValue(createTestSessionState({
+            sessionId: "source-id", currentTurnId: "active-turn",
+        }));
+        await expect(agent.extMethod("_session/fork", {sessionId: "source-id"}))
+            .rejects.toThrow("Invalid request");
+        await expect(agent.extMethod("_session/fork_edit", {
+            sessionId: "source-id", clientUserMessageId: "second-message",
+        })).rejects.toThrow("Invalid request");
+        expect(fork).not.toHaveBeenCalled();
+        expect(start).not.toHaveBeenCalled();
+    });
+});
