+    async forkSessionBeforeClientMessage(
+        sessionId: string,
+        clientUserMessageId: string,
+        cwd: string,
+        additionalDirectories: string[],
+        mcpServers: acp.McpServer[],
+        modelProvider: string | null,
+    ): Promise<string> {
+        const history = await this.codexClient.threadRead({
+            threadId: sessionId,
+            includeTurns: true,
+        });
+        const targetTurnIndex = history.thread.turns.findIndex((turn) =>
+            turn.items.some((item) =>
+                item.type === "userMessage" && item.clientId === clientUserMessageId
+            )
+        );
+        if (targetTurnIndex < 0) {
+            throw RequestError.invalidParams(
+                undefined,
+                `No Codex turn found for client user message ${clientUserMessageId}`,
+            );
+        }
+
+        await this.refreshSkills(cwd, additionalDirectories);
+        const config = await this.createSessionConfig(cwd, additionalDirectories, mcpServers);
+        if (targetTurnIndex === 0) {
+            const response = await this.codexClient.threadStart({
+                config,
+                cwd,
+                modelProvider,
+            });
+            return response.thread.id;
+        }
+
+        const previousTurn = history.thread.turns[targetTurnIndex - 1];
+        if (!previousTurn) {
+            throw RequestError.internalError(undefined, "Codex history is missing the preceding turn");
+        }
+        const response = await this.codexClient.threadFork({
+            threadId: sessionId,
+            lastTurnId: previousTurn.id,
+            config,
+            cwd,
+            modelProvider,
+        });
+        return response.thread.id;
+    }
+
+    async forkSession(
+        sessionId: string,
+        cwd: string,
+        additionalDirectories: string[],
+        mcpServers: acp.McpServer[],
+        modelProvider: string | null,
+    ): Promise<string> {
+        const history = await this.codexClient.threadRead({
+            threadId: sessionId,
+            includeTurns: true,
+        });
+
+        await this.refreshSkills(cwd, additionalDirectories);
+        const config = await this.createSessionConfig(cwd, additionalDirectories, mcpServers);
+        const lastTurn = history.thread.turns.at(-1);
+        if (!lastTurn) {
+            const response = await this.codexClient.threadStart({
+                config,
+                cwd,
+                modelProvider,
+            });
+            return response.thread.id;
+        }
+
+        const response = await this.codexClient.threadFork({
+            threadId: sessionId,
+            lastTurnId: lastTurn.id,
+            config,
+            cwd,
+            modelProvider,
+        });
+        return response.thread.id;
+    }
