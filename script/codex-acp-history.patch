+    private async forkEditedHistory(
+        params: {sessionId: string; clientUserMessageId: string},
+    ): Promise<{sessionId: string}> {
+        if (this.providerUpdate !== null) {
+            await this.providerUpdate;
+        }
+        const sessionState = this.getSessionState(params.sessionId);
+        if (this.activePrompts.has(params.sessionId) || sessionState.currentTurnId !== null) {
+            throw RequestError.invalidRequest("Cannot edit history while a Codex turn is active");
+        }
+
+        const oldSessionId = params.sessionId;
+        const newSessionId = await this.runWithProcessCheck(() =>
+            this.codexAcpClient.forkSessionBeforeClientMessage(
+                oldSessionId,
+                params.clientUserMessageId,
+                sessionState.cwd,
+                sessionState.additionalDirectories,
+                sessionState.mcpServers ?? [],
+                sessionState.authProvider,
+            )
+        );
+        await this.codexAcpClient.closeSession(oldSessionId);
+        this.sessions.delete(oldSessionId);
+        sessionState.sessionId = newSessionId;
+        sessionState.currentTurnId = null;
+        this.sessions.set(newSessionId, sessionState);
+        this.moveSessionMapEntry(this.pendingMcpStartupSessions, oldSessionId, newSessionId);
+        this.moveSessionMapEntry(this.pendingTurnStarts, oldSessionId, newSessionId);
+        this.moveSessionMapEntry(this.steeringQueues, oldSessionId, newSessionId);
+        this.sessionGenerations.delete(oldSessionId);
+        this.sessionOpenGenerations.delete(oldSessionId);
+        this.goalControlGenerations.delete(oldSessionId);
+        return {sessionId: newSessionId};
+    }
+
+    private async forkSessionForZed(params: {sessionId: string}): Promise<{sessionId: string}> {
+        if (this.providerUpdate !== null) {
+            await this.providerUpdate;
+        }
+        const sessionState = this.getSessionState(params.sessionId);
+        if (this.activePrompts.has(params.sessionId) || sessionState.currentTurnId !== null) {
+            throw RequestError.invalidRequest("Cannot fork a session while a Codex turn is active");
+        }
+
+        const newSessionId = await this.runWithProcessCheck(() =>
+            this.codexAcpClient.forkSessionForZed(
+                params.sessionId,
+                sessionState.cwd,
+                sessionState.additionalDirectories,
+                sessionState.mcpServers ?? [],
+                sessionState.authProvider,
+            )
+        );
+        return {sessionId: newSessionId};
+    }
+
+    private moveSessionMapEntry<T>(
+        map: Map<string, T>,
+        oldSessionId: string,
+        newSessionId: string,
+    ): void {
+        const value = map.get(oldSessionId);
+        map.delete(oldSessionId);
+        if (value !== undefined) {
+            map.set(newSessionId, value);
+        }
+    }
